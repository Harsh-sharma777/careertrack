# ==============================================================================
# CareerTrack - Environment Configuration Template
# Used when connecting CareerTrack to an external backend or database service.
# ==============================================================================

# Application Environment ('development' | 'production')
APP_ENV=development

# Storage Mode ('local' for LocalStorage DAL, 'api' for REST/GraphQL, 'supabase' for Supabase)
VITE_STORAGE_MODE=local

# Optional Backend API Endpoint (if replacing LocalStorage with an express / fastapi server)
VITE_API_BASE_URL=http://localhost:3000/api

# Optional Supabase / Firebase Credentials (if using managed backend)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# Analytics or Feature Flags
VITE_ENABLE_ANALYTICS=false
